+		int lerr = ENOENT;
+		if (loglun < 8) {
+			lerr = ufs_find_partition_on((uint8_t)loglun, logpart, &lf, &ln);
+		}
+		for (uint8_t l = 0; lerr && l < 8; l++) {
+			if (l == loglun) {
+				continue;
+			}
+			lerr = ufs_find_partition_on(l, logpart, &lf, &ln);
+			if (!lerr) {
