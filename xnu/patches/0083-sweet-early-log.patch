+			su.log_nblocks = ln;
+			su.log_ready = true;
+		} else if (!error) {
+			printf("SWEET LOG: early \"%s\" is too small (%llu blocks)\n",
+			    logpart, ln);
+			error = ENOSPC;
+		}
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error || !su.log_ready) {
+		printf("SWEET LOG: early init failed (%d)\n", error);
+		return error ? error : ENXIO;
+	}
+	printf("SWEET LOG: early log on LUN %u block 0x%llx, first flush...\n",
+	    (unsigned)su.log_lun, su.log_first_block);
+	int ferr = sweet_log_flush();
+	printf("SWEET LOG: early first flush -> %d, %llu bytes in ring\n",
+	    ferr, os_atomic_load(&sweet_log_total, relaxed));
+	return 0;
+}
+
+/* One synchronous pass of the thread loop above. Safe before BSD init. */
+int
+sweet_log_flush(void)
+{
+	static uint64_t flushed, seq;
+	uint64_t base = su.log_first_block;
+	void *bounce;
+	int error = 0;
+
+	if (!su.log_ready || sweet_log_busy) {
+		return 0;
+	}
+	sweet_log_busy = true;
+	bounce = (void *)(su.dma + DMA_BOUNCE);
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	if (total != flushed) {
+		uint64_t pos = total - flushed >= SWEET_LOG_SIZE ?
+		    total - SWEET_LOG_SIZE : flushed;
+
+		lck_mtx_lock(&sweet_ufs_lock);
+		while (pos < total && !error) {
+			uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+			uint32_t blk = off / UFS_BLOCK;
+			uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+			    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+			memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+			error = ufs_write_log_blocks(base + 1 + blk, n);
+			pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+		}
+		if (!error) {
+			struct sweet_log_header h = {
+				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+				.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++seq,
+			};
+			bzero(bounce, UFS_BLOCK);
+			memcpy(bounce, &h, sizeof(h));
+			error = ufs_write_log_blocks(base, 1);
+		}
+		if (!error) {
+			error = ufs_sync_cache_lun(su.log_lun);
+		}
+		lck_mtx_unlock(&sweet_ufs_lock);
+		if (!error) {
+			flushed = total;
+		} else if (error != sweet_log_last_error) {
+			sweet_log_last_error = error;
+			printf("SWEET LOG: flush error %d (total %llu)\n", error, total);
+		}
+	}
+	sweet_log_busy = false;
+	return error;
+}
