+/*
+ * Early log mode. The kernel can stop long before root is mounted, and then
+ * the ring above never reaches the partition. These two entry points are
+ * called from osfmk/kern/startup.c around each EARLY_BOOT initialiser, long
+ * before BSD init: they bring the polled UFS path up on their own (no
+ * bdevsw, no devfs, no thread) and push the ring out synchronously, so the
+ * last text written before a hang or a reset is on the partition.
+ */
+static bool sweet_log_early_done;
+static bool sweet_log_busy;
+static int sweet_log_last_error;
