+	if (!on || su.regs || su.log_ready) {
+		printf("SWEET LOG: early init: skipped (on=%u regs=%d ready=%d)\n",
+		    on, su.regs != 0, su.log_ready);
+		return 0;
+	}
+	if (SecureDTLookupEntry(NULL, "/sweet-ufs", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("SWEET LOG: early init: no /sweet-ufs node\n");
+		return ENXIO;
